---
import '../style.css';
import { Navigation } from '../components/Wiki.jsx';
import { catalogPath, aboutPath } from '../lib/routes.js';
const { page } = Astro.props;
const { scope, title, kind, category = 'all', type = 'craft' } = page;
---
<!doctype html>
<html lang="zh-CN" data-scope={scope}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title}：异星工厂 2.1.20 中文配方资料，分别查询游戏本体和太空时代。`} />
    <meta name="theme-color" content="#202222" />
    <title>{title} · 异星工厂中文 Wiki</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到内容</a>
    <header class="masthead"><a class="brand" href={catalogPath(scope)}><span class="brand-title">FACTORIO</span><span class="brand-sub">异星工厂中文 Wiki</span></a><div class="header-info"><span>2.1.20</span><span>非官方资料站</span></div></header>
    <div class="layout">
      <aside class="sidebar" aria-label="资料分类"><div class="nav-heading">导航</div><Navigation scope={scope} category={category} type={type} kind={kind} /><div class="nav-heading secondary-nav">查阅</div><a href={aboutPath(scope)}>数据来源与收录范围</a><a href="https://wiki.factorio.com/Main_Page/zh" target="_blank" rel="noreferrer">Factorio 官方 Wiki ↗</a><p class="sidebar-note">本体与太空时代分别查询。<br />配方版本固定为 2.1.20。</p></aside>
      <div class="content"><div class="page-tabs"><a href={catalogPath(scope)} class:list={{current:kind !== 'about'}}>资料库</a><a href={aboutPath(scope)} class:list={{current:kind === 'about'}}>资料说明</a><span>简体中文</span></div>
        <main id="main" tabindex="-1"><slot /></main>
        <footer>Factorio © Wube Software · 数据整理自 FactorioLab · <a href={aboutPath(scope)}>来源与说明</a></footer>
      </div>
    </div>
    <script>
      import { legacyTarget } from '../lib/routes.js';
      function migrateLegacyLink() {
        const target = legacyTarget(window.location.hash);
        if (target) window.location.replace(target);
      }
      migrateLegacyLink();
      window.addEventListener('hashchange', migrateLegacyLink);
    </script>
  </body>
</html>
